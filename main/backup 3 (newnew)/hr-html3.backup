<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GPPB HR Portal</title>
    <link rel="stylesheet" href="hr-css.css">
</head>
<body>
<header class="header">
        <div class="header-left">
            <button class="hamburger" aria-label="Toggle Sidebar">☰</button>
            <img id="logo-home" src="../assets/gppb2.png" alt="GPPB2 Logo" class="logo" style="cursor: pointer;">
        </div>
        <div class="header-right">
            <div class="contact-and-search">
                <div class="contact-info">
                    <div class="phone">
                        <img src="../assets/phoneicon.png" alt="Phone" class="contact-icon">
                        (123) 456-7890
                    </div>
                    <div class="email">
                        <img src="../assets/mailicon.png" alt="Email" class="contact-icon">
                        info@gppb.gov
                    </div>
                </div>
                <div class="search-container">
                    <img src="../assets/searchicon.png" alt="Search" class="search-icon">
                    <input type="search" class="search-bar" placeholder="Search...">
                </div>
            </div>
            <img src="../assets/gppb3.png" alt="GPPB3 Logo" class="logo">
        </div>
    </header>

    <!-- Sidebar -->
    <div class="container">
        <div class="sidebar-overlay"></div>
        <nav class="sidebar">
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#careers">Careers</a></li>
                <li><a href="#recruitment">Recruitment</a></li>
                <li><a href="#discussion-board">Discussion Board</a></li>
                <li><a href="#downloadable-forms" id="download-link">Downloadable Files</a></li>
                <li><a href="#learning-development">Learning and Development</a></li>
                <li><a href="#rewards-recognition">Rewards & Recognition</a></li>
                <li><a href="#">Leave Requests</a></li>
            </ul>
            <div class="clock">
                <div id="time">00:00:00</div>
                <div id="date"></div>
            </div>
        </nav>
        <!-- The image at home -->
        <main class="main-content">
            <div id="page-indicator" class="page-indicator">HOME</div>
            <div id="home" class="hero-section">
                <div class="hero-slider">
                    <div class="slide active">
                        <img src="../assets/hr-2.png" alt="Office team" class="hero-img">
                        <div class="hero-overlay">
                            <h2>Welcome to GPPB HR</h2>
                            <p>Empowering our workforce for government excellence.</p>
                        </div>
                    </div>
                    <div class="slide">
                        <img src="../assets/gg.png" alt="Office team" class="hero-img">
                        <div class="hero-overlay">
                            <h2>Employee Success</h2>
                            <p>Managing careers and growth in public service.</p>
                        </div>
                    </div>
                    <div class="slide">
                        <img src="../assets/hr5.png" alt="Government building" class="hero-img">
                        <div class="hero-overlay">
                            <h2>Government HR Excellence</h2>
                            <p>Official announcements and updates.</p>
                        </div>
                    </div>
                </div>
                <div class="hero-nav">
                    <span class="dot active" data-slide="0"></span>
                    <span class="dot" data-slide="1"></span>
                    <span class="dot" data-slide="2"></span>
                </div>
            </div>

            <!-- NEW HR RESOURCES SECTION -->
            <section id="hr-resources" class="hr-resources">
                <div class="resources-header">
                    <h2>Explore HR Resources, Policies, Training, Internship and Job Opportunities.</h2>
                </div>

                <div class="resources-grid">
                    <div class="resource-card">
                        <div class="resource-icon">💼</div>
                        <h3>JOB OPENINGS</h3>
                        <p>Explore available roles and apply for opportunities.</p>
                    </div>

                    <div class="resource-card">
                        <div class="resource-icon">📄</div>
                        <h3>FORMS & DOCUMENTS</h3>
                        <p>Access forms, policies, and essential HR resources.</p>
                    </div>

                    <div class="resource-card">
                        <div class="resource-icon">🎓</div>
                        <h3>INTERNSHIPS</h3>
                        <p>Gain experience through hands-on internship programs.</p>
                    </div>
                </div>
            </section>

            <!-- Recruitment Section -->
            <section id="recruitment" class="download-section" style="display: none;">
                <div class="section-header">
                    <h2>Vacant Positions</h2>
                    <p class="section-desc">Current job openings at GPPB</p>
                </div>
                <div class="recruitment-backdrop">
                    <div class="download-grid">
                        <div class="download-card recruitment-group">
                            <div class="position-title">
                                <div class="position-icon">👩‍⚕️</div>
                                <h3>SOCIAL WELFARE OFFICER IV</h3>
                            </div>
                            <ul class="position-list">
                                <li>OSEC-DSWDB-SOCWO4-297-2004</li>
                                <li>OSEC-DSWDB-SOCWO4-298-2004</li>
                                <li>OSEC-DSWDB-SOCWO4-299-2004</li>
                            </ul>
                            <div class="position-deadline">End of Publication: March 27, 2026</div>
                            <a href="#" class="download-btn">View Details →</a>
                        </div>

                        <div class="download-card recruitment-group">
                            <div class="position-title">
                                <div class="position-icon">📊</div>
                                <h3>ACCOUNTANT III</h3>
                            </div>
                            <ul class="position-list">
                                <li>OSEC-DSWDB-A3-1-2010</li>
                            </ul>
                            <div class="position-deadline">End of Publication: March 27, 2026</div>
                            <a href="#" class="download-btn">View Details →</a>
                        </div>

                        <div class="download-card recruitment-group">
                            <div class="position-title">
                                <div class="position-icon">⚖️</div>
                                <h3>LEGAL ASSISTANT III</h3>
                            </div>
                            <ul class="position-list">
                                <li>OSEC-DSWDB-LEA3-3-2020</li>
                            </ul>
                            <div class="position-deadline">End of Publication: March 29, 2026</div>
                            <a href="#" class="download-btn">View Details →</a>
                        </div>

                        <div class="download-card recruitment-group">
                            <div class="position-title">
                                <div class="position-icon">📋</div>
                                <h3>ADMINISTRATIVE OFFICER V</h3>
                            </div>
                            <ul class="position-list">
                                <li>OSEC-DSWDB-ADOF5-2-2021</li>
                            </ul>
                            <div class="position-deadline">End of Publication: April 2, 2026</div>
                            <a href="#" class="download-btn">View Details →</a>
                        </div>
                    </div>
                </div>
            </section>
            
            <!-- Placeholder Stack FIRST (no text) -->
            <div id="placeholder-section" class="image-stack" style="display: none;">
                <div class="stack-slide active" style="background-image: url('../assets/pplA.png');"></div>
                <div class="stack-slide" style="background-image: url('../assets/pplB.png');"></div>
            </div>

            <!-- Pure Parallax supp.png -->
            <div id="supp-section" class="parallax-section" style="display: none;">
                <div class="parallax-bg" data-img="../assets/supp.png"></div>
            </div>

            <section id="learning-development" class="learning-section" style="display: none;">
                <div class="content-placeholder" style="text-align: center; padding: 4rem;">
                    <div style="font-size: 5rem; margin-bottom: 1.5rem;">📚</div>
                    <h2>Learning & Development</h2>
                    <p style="font-size: 1.3rem; color: #666; max-width: 500px; margin: 0 auto 2rem;">Coming Soon: Online courses, certification programs, leadership training, and skill development workshops for GPPB staff.</p>
                    <div class="card-grid">
                        <div class="card">
                            <h3>Training Catalog</h3>
                            <p>50+ courses available</p>
                        </div>
                        <div class="card">
                            <h3>Certification Tracker</h3>
                            <p>Track your progress</p>
                        </div>
                    </div>
                </div>
            </section>

            <section id="rewards-recognition" class="rewards-section" style="display: none;">
                <div class="section-header">
                    <h2>Rewards & Recognition</h2>
                    <p class="section-desc">Celebrating excellence and outstanding contributions</p>
                </div>
                <div class="download-grid">
                    <div class="download-card">
                        <div class="download-icon">🏆</div>
                        <h3>Performance Awards</h3>
                        <p>Employee of the Month/Quarter, Innovation Champion, Service Excellence Awards</p>
                    </div>
                    <div class="download-card">
                        <div class="download-icon">⭐</div>
                        <h3>Nominate Colleague</h3>
                        <p>Recognize outstanding peers</p>
                        <a href="#" class="download-btn">Submit Nomination →</a>
                    </div>
                    <div class="download-card">
                        <div class="download-icon">🎖️</div>
                        <h3>Leaderboard</h3>
                        <p>Test (245 pts) | Test 2 (198 pts) | Test 3 (167 pts)</p>
                    </div>
                </div>
            </section>



            <!-- Discussion Board Section -->
            <section id="discussion-board" class="discussion-section" style="display: none;">

            <div class="section-header">
                <div class="feedback-container">
                    <!-- Form -->
                    <div class="feedback-form-card">
                        <h3>Submit Feedback</h3>
                        <form id="feedback-form">
                            <div class="name-row">
                                <input type="text" id="first-name" placeholder="First Name" required maxlength="30">
                                <input type="text" id="last-name" placeholder="Last Name" required maxlength="15">
                            </div>
                            <input type="text" id="department" placeholder="Department" required>
                            <input type="email" id="email" placeholder="Email" required maxlength="254">
                            <textarea id="feedback-text" placeholder="Your feedback..." required maxlength="500"></textarea>

                        <button type="submit" class="btn btn-primary submit-btn">Submit Feedback</button>
                        <button type="button" id="admin-login-btn" class="btn btn-secondary admin-btn">Login as admin</button>
                        </form>

                        <!-- Admin Login Modal -->
                        <div id="admin-modal" class="modal" style="display: none;">
                          <div class="modal-content">
                            <span class="close">&times;</span>
                            <h3>Admin Login</h3>
                            <form id="admin-form">
                                <div id="admin-error" class="error-message" style="display: none;"></div>

                                <input type="text" id="admin-username" placeholder="Username">
                                <input type="password" id="admin-password" placeholder="Password">

                                <button type="submit" class="btn btn-primary">Login</button>
                            </form>
                          </div>
                        </div>

                        <!-- Admin Reply Modal -->
                        <div id="reply-modal" class="modal" style="display: none;">
                          <div class="modal-content">
                            <span class="close">&times;</span>
                            <h3>Reply to Feedback</h3>
                            <form id="reply-form">
                                <textarea id="reply-text" placeholder="Type your reply here..." rows="4" required></textarea>
                                <button type="submit" class="btn btn-primary">Send Reply</button>
                            </form>
                          </div>
                        </div>

                        <!-- Success Modal -->
                        <div id="success-modal" class="modal" style="display: none;">
                          <div class="modal-content success-modal-content">
                            <span class="close">&times;</span>
                            <div class="success-icon">✅</div>
                            <h3 id="success-title">Success</h3>
                            <p id="success-message"></p>
                          </div>
                        </div>

                    </div>

                    <!-- Discussion Board Tabs -->
                    <div class="discussion-tabs">
                        <button class="discussion-tab tab-active" data-tab="high-priority">🚨 High Priority</button>
                        <button class="discussion-tab" data-tab="resolved">✅ Resolved</button>
                        <button class="discussion-tab" data-tab="pending">⏳ Pending</button>
                        <button class="discussion-tab" data-tab="not-viewed">📩 Not Viewed</button>
                    </div>

                    <!-- Category Grids -->
                    <div id="category-high-priority" class="category-grid feedbacks-grid"></div>
                    <div id="category-pending" class="category-grid feedbacks-grid" style="display: none;"></div>
                    <div id="category-not-viewed" class="category-grid feedbacks-grid" style="display: none;"></div>
                    <div id="category-resolved" class="category-grid feedbacks-grid" style="display: none;"></div>


                </div>
            </section>

            <!-- Downloadable Files Section -->
            <section id="downloadable-forms" class="download-section" style="display: none;">
                <div class="section-header">
                    <h2>Downloadable Forms</h2>
                    <p class="section-desc">Official HR forms and documents for GPPB employees</p>
                </div>
                <div class="download-grid">
                        <div class="download-card">
                            <div class="download-icon">📄</div>
                            <h3>Leave Request Form</h3>
                            <p>Standard leave application form</p>
                            <a href="#" class="download-btn" data-file="Leave-Request-Form.pdf">Download PDF <span>→</span></a>
                        </div>
                        <div class="download-card">
                            <div class="download-icon">📋</div>
                            <h3>Employment Certificate</h3>
                            <p>Certificate of employment verification</p>
                            <a href="#" class="download-btn" data-file="Employment-Certificate.pdf">Download PDF <span>→</span></a>
                        </div>
                        <div class="download-card">
                            <div class="download-icon">📝</div>
                            <h3>Personal Info Update</h3>
                            <p>Form to update employee information</p>
                            <a href="#" class="download-btn" data-file="Change-Info-Form.pdf">Download PDF <span>→</span></a>
                        </div>
                        <div class="download-card">
                            <div class="download-icon">💰</div>
                            <h3>Payroll Authorization</h3>
                            <p>Payroll change authorization form</p>
                            <a href="#" class="download-btn" data-file="Payroll-Auth.pdf">Download PDF <span>→</span></a>
                        </div>
                        <div class="download-card"> 
                            <div class="download-icon">📜</div>
                            <h3>Overtime Request</h3>
                            <p>Overtime approval request form</p>
                            <a href="#" class="download-btn" data-file="Overtime-Form.pdf">Download PDF <span>→</span></a>
                        </div>
                        <div class="download-card">
                            <div class="download-icon">🏥</div>
                            <h3>Medical Reimbursement</h3>
                            <p>Medical expense reimbursement claim</p>
                            <a href="#" class="download-btn" data-file="Medical-Reimbursement.pdf">Download PDF <span>→</span></a>
                        </div>
                </div>
                <div class="download-instructions">
                    <h4>Instructions:</h4>
                    <ul>
                        <li>Download the form you need</li>
                        <li>Fill out completely and legibly</li>
                        <li>Submit to HR Department (signed by immediate supervisor where applicable)</li>
                        <li>Digital signatures accepted for most forms</li>
                    </ul>
                </div>
            </section>
        </main>

        <div class="shenanigans">
            <div class="floating-icon" data-icon="👋"></div>
            <div class="floating-icon" data-icon="📊"></div>
            <div class="floating-icon" data-icon="💼"></div>
            <div class="floating-icon" data-icon="📈"></div>
            <canvas id="particles-canvas"></canvas>
        </div>
    </div>

    <script src="hr-js.js"></script>
</body>
</html>
    